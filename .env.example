# Copy to .env (or set in your host's dashboard). Only BASE_URL, ADMIN_EMAIL and ADMIN_PASSWORD are needed to start.
NODE_ENV=production
PORT=3000
# Public address, used in e-mail links. https:// turns on Secure cookies.
BASE_URL=https://afterworc.com
# First staff account (created on start if missing).
ADMIN_EMAIL=you@afterworc.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Outgoing mail, e.g. smtps://user:pass@smtp.example.com:465 . Without it, e-mails are only logged (staff console › E-mails).
SMTP_URL=
MAIL_FROM=AfterWorc <info@afterworc.com>
# Where staff notifications go (new briefs, requests, messages).
STAFF_EMAIL=info@afterworc.com
# Name shown as the matcher on briefs.
MATCHER_NAME=AfterWorc matching
# Specialist fee taken at release, in percent (0 during the founding period).
WORKER_FEE_PCT=0
# Real top-ups by card / Apple Pay / Google Pay through Stripe Checkout. Leave empty to stay in test mode.
# Webhook endpoint to add in the Stripe dashboard: https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where the SQLite database and uploads live. Mount a persistent volume here.
DATA_DIR=/data
# Set to 1 behind a reverse proxy (Fly, Render, nginx) so rate limits see real client IPs.
TRUST_PROXY=1
# Demo account demo@afterworc.com (on by default outside production; set 1 to seed it in production).
SEED_DEMO=0
# Calls (voice/video in Messages). STUN is public by default; add a TURN server for strict corporate networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USER=
TURN_PASS=
