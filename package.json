{
  "name": "afterworc",
  "version": "1.0.0",
  "private": true,
  "description": "AfterWorc: build your workforce, we run the rest. Checked specialists, teams, departments and hiring abroad (EOR). Public site, React account and staff console, REST + WebSocket API.",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev:web": "vite",
    "start": "node scripts/ensure-build.js && node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/ensure-build.js && node test/browser.e2e.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
